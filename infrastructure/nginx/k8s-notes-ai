server {
    server_name k8s-notes-ai.duckdns.org;

    root /opt/k8s-notes-ai/frontend;
    index index.html;

    client_max_body_size 20m;

    location /api/ {
        limit_req zone=general_api burst=10 nodelay;
        limit_req_status 429;

        limit_conn per_ip_connections 20;

        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /api/answer {
        limit_req zone=ai_api burst=2 nodelay;
        limit_req_status 429;

        limit_conn per_ip_connections 5;

        proxy_pass http://127.0.0.1:8000/answer;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /api/answer/stream {
        limit_req zone=ai_api burst=2 nodelay;
        limit_req_status 429;

        limit_conn per_ip_connections 5;

        proxy_pass http://127.0.0.1:8000/answer/stream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;

    ssl_certificate /etc/letsencrypt/live/k8s-notes-ai.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/k8s-notes-ai.duckdns.org/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;

    server_name k8s-notes-ai.duckdns.org;

    return 301 https://$host$request_uri;
}